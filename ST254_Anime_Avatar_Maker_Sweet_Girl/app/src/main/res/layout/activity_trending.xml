<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.trending.TrendingActivity">

    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/id_space"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/app2"
        />

    <ImageView
        android:id="@+id/id_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/i_space"
        app:layout_constraintDimensionRatio="360:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvImage" />

    <!--    cvImage-->
    <FrameLayout
        android:id="@+id/cvImage"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintVertical_bias=".0">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/dp_0"
            app:layout_constraintDimensionRatio="1:1"
            >


            <ImageView
                android:id="@+id/imvImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp_0"
                android:scaleType="fitCenter" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/guidRandom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp_0"
                android:background="@drawable/guide_random" />
        </com.google.android.material.card.MaterialCardView>


    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/click_the_random_button_below_to_see_nwhat_your_character_is"
        app:layout_constraintTop_toBottomOf="@id/id_space"
        android:textColor="@color/app"
        android:fontFamily="@font/londrina_solid_regular"
        android:gravity="center"
        android:textSize="@dimen/sp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:id="@+id/tvGuide"
        />

    <FrameLayout
        android:id="@+id/btnGenerate"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/bg_btn"
        app:layout_constraintTop_toBottomOf="@id/tvGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dp_16"
        >
        <com.baba.bobo.core.custom.text.DoubleStrokeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generate"
            android:textSize="@dimen/sp_16"
            android:fontFamily="@font/londrina_solid_regular"
            android:gravity="center"
            android:textColor="@color/white"
            app:outerStrokeWidth="@dimen/dp_2"
            app:outerStrokeColor="@color/app3"
            android:layout_gravity="center"
            android:id="@+id/tvGenerate"
            />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/btnEdit"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_68"
        android:layout_marginEnd="@dimen/dp_4"
        android:visibility="gone"
        android:background="@drawable/bg_12dp"
        app:layout_constraintEnd_toStartOf="@id/btnGenerate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvImage">

        <TextView
            android:id="@+id/tvEdit"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/dp_30"
            android:layout_marginEnd="@dimen/dp_30"
            android:fontFamily="@font/londrina_solid_regular"
            android:gravity="center"
            android:text="@string/edit"
            android:textColor="@color/figma_primary"
            android:textSize="@dimen/sp_16"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </FrameLayout>


    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
