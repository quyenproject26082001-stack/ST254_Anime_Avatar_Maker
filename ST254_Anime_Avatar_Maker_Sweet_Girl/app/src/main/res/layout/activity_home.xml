<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_app" />

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_52"
        android:layout_marginEnd="@dimen/dp_20"
        android:contentDescription="@string/settings"
        android:scaleType="fitXY"
        android:src="@drawable/ic_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgAppName"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_112"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/img_home_logo_figma"
        app:layout_constraintDimensionRatio="360:80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scvMain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_236"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_68">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent=".5" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnPlay"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_0"
                android:layout_marginEnd="@dimen/dp_4"
                android:background="@drawable/i_home_1"
                app:cardCornerRadius="@dimen/dp_12"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="@id/glV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <com.baba.bobo.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tv1"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_46"
                    android:fontFamily="@font/londrina_solid_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:text="@string/play"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_24"
                    app:autoSizeMaxTextSize="@dimen/sp_28"
                    app:autoSizeMinTextSize="@dimen/sp_18"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias=".99" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnCosPlay"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_marginStart="@dimen/dp_4"
                android:background="@drawable/i_home_2"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/glV"
                app:layout_constraintTop_toTopOf="@id/btnPlay"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.baba.bobo.core.custom.text.DoubleStrokeTextView
                            android:id="@+id/tv2"
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="@dimen/dp_46"
                            android:fontFamily="@font/londrina_solid_regular"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/cosplay_therian"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sp_24"
                            app:autoSizeMaxTextSize="@dimen/sp_28"
                            app:autoSizeMinTextSize="@dimen/sp_18"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias=".99" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnRandom"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_4"
                android:background="@drawable/i_home_3"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="@id/glV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCosPlay"
                app:strokeColor="@color/figma_primary"
                app:strokeWidth="@dimen/dp_2">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.baba.bobo.core.custom.text.DoubleStrokeTextView
                        android:id="@+id/tv3"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_46"
                        android:fontFamily="@font/londrina_solid_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/avatar_random"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_24"
                        app:autoSizeMaxTextSize="@dimen/sp_28"
                        app:autoSizeMinTextSize="@dimen/sp_18"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias=".99" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnMyCreation"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_marginStart="@dimen/dp_4"
                android:background="@drawable/i_home_4"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/glV"
                app:layout_constraintTop_toTopOf="@id/btnRandom">


                <com.baba.bobo.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tv4"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_46"
                    android:fontFamily="@font/londrina_solid_regular"
                    android:gravity="center"
                    app:layout_constraintVertical_bias=".99"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/creation"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_28"
                    app:autoSizeMaxTextSize="@dimen/sp_28"
                    app:autoSizeMinTextSize="@dimen/sp_18"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/flNativeCollab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
