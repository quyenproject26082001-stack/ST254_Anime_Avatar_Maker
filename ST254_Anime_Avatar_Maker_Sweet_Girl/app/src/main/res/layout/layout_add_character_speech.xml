<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnlSpeech"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/dp_22"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
         />



    <!--            rcvFont-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_10"
        android:clipChildren="false"
        android:clipToPadding="true"
        android:layout_marginTop="@dimen/dp_8"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_0_5"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_font" />

    <!--            rcvTextColor-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvTextColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:layout_marginVertical="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/rcvFont"
        tools:listitem="@layout/item_text_color" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvCategory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_8"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/rcvTextColor"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_category"
        tools:visibility="visible" />

    <!--            rcvSticker-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvSpeech"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/dp_18"
        app:layout_constraintTop_toBottomOf="@id/rcvCategory"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="5"
        tools:listitem="@layout/item_speech" />
</androidx.constraintlayout.widget.ConstraintLayout>
