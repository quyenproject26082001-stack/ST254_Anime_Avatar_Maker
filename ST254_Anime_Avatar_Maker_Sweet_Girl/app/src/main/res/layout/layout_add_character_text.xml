<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scvText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:isScrollContainer="true"
    android:scrollbars="none"
    android:clipToPadding="true"
    android:visibility="gone"
    android:background="@color/app2"
    tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:background="@color/app2"
        android:orientation="vertical">

            <!--                    btnDoneText-->
            <ImageView
                android:id="@+id/btnDoneText"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintStart_toEndOf="@id/edtText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_done_background" />




        <!--            edtText-->
        <EditText
            android:id="@+id/edtText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_36"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_64"
            android:background="@drawable/bg_edit_text"
            android:ellipsize="end"
            android:fontFamily="@font/londrina_solid_regular"
            app:layout_constraintTop_toTopOf="@id/btnDoneText"
            android:hint="@string/hello_world_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="30"
            android:paddingHorizontal="@dimen/dp_16"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="#808080"
            android:textSize="@dimen/sp_16" />

        <!--            rcvFont-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_10"
            android:clipChildren="false"
            android:clipToPadding="true"
            android:layout_marginTop="@dimen/dp_8"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_0_5"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/edtText"
            tools:listitem="@layout/item_font" />

        <!--            rcvTextColor-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvTextColor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"
            android:layout_marginVertical="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/rcvFont"
            tools:listitem="@layout/item_text_color" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
