<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <!--    flOutSide-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flOutSide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToOutline="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgLight"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0"
            android:visibility="gone"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_48"
            android:elevation="@dimen/dp_4"
            app:layout_constraintBottom_toTopOf="@id/layoutMain"
            app:layout_constraintStart_toStartOf="@id/layoutMain"
            app:layout_constraintEnd_toEndOf="@id/layoutMain"
            android:background="@drawable/ic_title"
            android:translationY="@dimen/dp_24"
            />

        <!--        layoutMain-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMain"
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_400"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:clipChildren="false"
            android:clipToOutline="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="#EDEDFF"
            app:cardElevation="@dimen/dp_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_dialog_next" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:clipChildren="false"
                android:fontFamily="@font/londrina_solid_regular"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_30"
                android:text="@string/cosplay_results"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_24"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ctnImg"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                app:layout_constraintBottom_toBottomOf="parent"

                app:strokeColor="@color/transparent"
                android:layout_gravity="center"
                app:layout_constraintVertical_bias=".15"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.875">


                <ImageView
                    android:id="@+id/btnImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/dp_0"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp_3"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/dp_7"
                app:strokeColor="@color/transparent">

                <ImageView
                    android:id="@+id/btnSamplePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/dp_0"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ctnProgress"
                android:layout_width="@dimen/dp_260"
                android:layout_height="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_progress_empty_h"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/tvRef"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ctnImg">

                <ImageView
                    android:id="@+id/sbProgressFull"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_progress_full_h" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/icThumb"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@drawable/ic_thumb"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ctnProgress"
                app:layout_constraintStart_toStartOf="@id/ctnProgress"
                app:layout_constraintTop_toTopOf="@id/ctnProgress" />


            <TextView
                android:id="@+id/tvRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/dp_20"
                android:fontFamily="@font/londrina_solid_regular"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_10"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ctnProgress"
                tools:text="100%" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <FrameLayout
            android:id="@+id/llButtons"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_28"
            android:layout_marginBottom="@dimen/dp_33"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/ic_close"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintDimensionRatio="156:44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMain"
            app:strokeColor="@color/figma_primary"
            app:strokeWidth="@dimen/dp_2">


            <!--                    btnYes-->
            <TextView
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/londrina_solid_regular"
                android:gravity="center"
                android:paddingVertical="@dimen/dp_9"
                android:textColor="@color/figma_primary"
                android:textSize="@dimen/sp_16" />
        </FrameLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
