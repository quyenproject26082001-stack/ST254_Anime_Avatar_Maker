<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:tool="http://schemas.android.com/tools"
    android:paddingBottom="@dimen/dp_22"
    tool:background="@color/dark"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlShareButtons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="328:40"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">








        <!--            btnLeft-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toStartOf="@id/btnRight"
            app:layout_constraintDimensionRatio="160:40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_4"
        >

            <FrameLayout
                android:id="@+id/ctnBg1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:strokeColor="@color/transparent"
                app:cardElevation="@dimen/dp_0"
                app:cardBackgroundColor="@color/transparent"
                app:layout_constraintBottom_toBottomOf="@+id/lnlInRight"
                app:layout_constraintEnd_toEndOf="@+id/lnlInRight"
                app:layout_constraintStart_toStartOf="@+id/lnlInRight"
                app:layout_constraintTop_toTopOf="@+id/lnlInRight">

                <ImageView
                    android:id="@+id/imgBgBtnLeft"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_telegram_shape" />
            </FrameLayout>

            <!--                        lnlInRight-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lnlInRight"
                android:layout_width="match_parent"
                app:layout_constraintEnd_toEndOf="@id/ctnBg1"
                app:layout_constraintStart_toStartOf="@id/ctnBg1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:visibility="gone"
                    android:src="@drawable/ic_telegram" />

                <!--                        tvTelegram-->
                <com.baba.bobo.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvTelegram"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/dp_6"
                    android:fontFamily="@font/londrina_solid_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.53"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/add_to_telegram"
                    android:textColor="@color/white"
                    app:outerStrokeColor="#006699"
                    android:autoSizeMaxTextSize="@dimen/sp_24"
                    android:autoSizeMinTextSize="@dimen/sp_12"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    app:outerStrokeWidth="@dimen/dp_2"
                    android:textSize="@dimen/sp_16" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!--            btnRight-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnRight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="160:40"
            app:layout_constraintStart_toEndOf="@id/btnLeft"
            android:layout_marginEnd="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            >

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ctnBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:cardElevation="@dimen/dp_0"
                app:cardBackgroundColor="@color/transparent"

                app:strokeColor="@color/transparent"
                app:layout_constraintBottom_toBottomOf="@+id/lnlInLeft"
                app:layout_constraintEnd_toEndOf="@+id/lnlInLeft"
                app:layout_constraintStart_toStartOf="@+id/lnlInLeft"
                app:layout_constraintTop_toTopOf="@+id/lnlInLeft">

                <ImageView
                    android:id="@+id/imgBgBtnRight"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_whatsapp_shape" />
            </com.google.android.material.card.MaterialCardView>

            <!--                        lnlInLeft-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lnlInLeft"
                android:layout_width="match_parent"
                app:layout_constraintStart_toStartOf="@id/ctnBg"
                app:layout_constraintEnd_toEndOf="@id/ctnBg"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:visibility="gone"
                    android:src="@drawable/ic_whatsapp" />

                <!--                        tvWhatsapp-->
                <com.baba.bobo.core.custom.text.DoubleStrokeTextView
                    android:id="@+id/tvWhatsapp"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="@dimen/dp_6"
                    android:fontFamily="@font/londrina_solid_regular"
                    android:text="@string/add_to_whatsapp"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/white"
                    app:outerStrokeColor="#009933"
                    app:layout_constraintHeight_percent="0.53"
                    android:autoSizeMaxTextSize="@dimen/sp_24"
                    android:autoSizeMinTextSize="@dimen/sp_12"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    app:outerStrokeWidth="@dimen/dp_2"
                    android:textSize="@dimen/sp_16"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

  


</androidx.constraintlayout.widget.ConstraintLayout>
