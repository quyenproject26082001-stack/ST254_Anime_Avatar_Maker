<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".ui.view.ViewActivity">


    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    cvImage-->
    <FrameLayout
        android:id="@+id/cvImage"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_0"
        android:layout_marginBottom="@dimen/dp_16"
        android:visibility="visible"
        android:layout_marginTop="@dimen/dp_6"
        app:strokeWidth="@dimen/dp_2"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:strokeColor="#861629"
        app:cardCornerRadius="@dimen/dp_4"
        >

        <!--        imvImage-->
        <ImageView
            android:id="@+id/imvImage"
            android:padding="@dimen/dp_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center" />
    </FrameLayout>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    app:layout_constraintTop_toBottomOf="@id/id_space"
    app:layout_constraintBottom_toBottomOf="parent"
    android:background="@color/app2"/>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="360:16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/cvImage"
        android:background="@drawable/i_space"
        android:id="@+id/id_space"/>
    <FrameLayout
        android:id="@+id/btnEdit"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/bg_btn"
        app:layout_constraintTop_toBottomOf="@id/cvImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dp_16"
        >
        <com.baba.bobo.core.custom.text.DoubleStrokeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:textSize="@dimen/sp_16"
            android:fontFamily="@font/londrina_solid_regular"
            android:gravity="center"
            android:textColor="@color/white"
            app:outerStrokeWidth="@dimen/dp_2"
            app:outerStrokeColor="@color/app3"
            android:layout_gravity="center"
            />
    </FrameLayout>


    <!--    lnlBottom-->
    <FrameLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_0"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <include
            android:id="@+id/includeLayoutBottom"
            layout="@layout/layout_bottom_view" />

    </FrameLayout>


